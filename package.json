{
  "name": "typescript-aws-serverless-starter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "build:lambda": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=cjs --minify --outfile=dist-lambda/lambda.cjs",
    "test": "npm run build && npm run build:lambda && node --test dist/tests/application.test.js",
    "dev:local": "npm run build && node dist/src/local.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "3.1154.0",
    "@aws-sdk/client-eventbridge": "3.1154.0",
    "@aws-sdk/lib-dynamodb": "3.1154.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "prettier": "3.9.10"
  }
}
